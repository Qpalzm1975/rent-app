# Local development: copy to .env.local. Production: Vercel environment secrets.
# Never prefix server credentials with NEXT_PUBLIC_. Never commit a filled file.
APP_ORIGIN=http://localhost:3000
AUTH_MODE=password
OWNER_PASSWORD_HASH=
SESSION_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REDBARK_API_KEY=
# Pinned to the currently documented beta contract (verified 2026-09-28).
REDBARK_API_VERSION=2026-10-01.wattle
REDBARK_WEBHOOK_SECRET=
REDBARK_WEBHOOK_SECRET_PREVIOUS=
REDBARK_EVENT_SECRET=
REDBARK_EVENT_SECRET_PREVIOUS=
CRON_SECRET=
# Optional Sites-only owner authentication; do not use on Vercel.
SITES_OWNER_EMAIL=
